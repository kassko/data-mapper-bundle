{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block head %}
    {{ parent() }}
    <style>
        .data-mapper-panel {
            padding: 20px;
        }
        .data-mapper-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 30px;
        }
        .data-mapper-stat {
            background: var(--metric-value-background);
            border-radius: 8px;
            padding: 15px 20px;
            min-width: 120px;
            text-align: center;
        }
        .data-mapper-stat .value {
            font-size: 24px;
            font-weight: bold;
            color: var(--color-text);
        }
        .data-mapper-stat .label {
            font-size: 12px;
            color: var(--color-muted);
            text-transform: uppercase;
        }
        .data-mapper-event {
            margin-bottom: 10px;
            padding: 10px 15px;
            border-left: 3px solid var(--tab-border-color);
            background: var(--table-background);
            border-radius: 0 4px 4px 0;
        }
        .data-mapper-event.datasource_call {
            border-left-color: #3498db;
        }
        .data-mapper-event.property_hydration {
            border-left-color: #27ae60;
        }
        .data-mapper-event.property_skipped {
            border-left-color: #e67e22;
        }
        .data-mapper-event.property_transformed {
            border-left-color: #9b59b6;
        }
        .data-mapper-event.hook_executed {
            border-left-color: #1abc9c;
        }
        .data-mapper-event.custom_hydrator {
            border-left-color: #e74c3c;
        }
        .data-mapper-event.context_set {
            border-left-color: #f39c12;
        }
        .data-mapper-event.decision_point {
            border-left-color: #95a5a6;
        }
        .data-mapper-event-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
        }
        .data-mapper-event-type {
            font-weight: bold;
            font-size: 12px;
            text-transform: uppercase;
            padding: 2px 8px;
            border-radius: 3px;
            background: var(--color-muted);
            color: var(--color-background);
        }
        .data-mapper-event-timestamp {
            font-size: 11px;
            color: var(--color-muted);
        }
        .data-mapper-event-details {
            font-size: 13px;
        }
        .data-mapper-event-details code {
            background: var(--base-1);
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 12px;
        }
        .data-mapper-depth {
            margin-left: 20px;
        }
        .data-mapper-class-group {
            margin-bottom: 20px;
        }
        .data-mapper-class-header {
            font-weight: bold;
            margin-bottom: 10px;
            padding: 10px;
            background: var(--table-header);
            border-radius: 4px;
        }
        .data-mapper-no-events {
            text-align: center;
            padding: 40px;
            color: var(--color-muted);
        }
        .data-mapper-disabled-notice {
            text-align: center;
            padding: 30px;
            background: var(--color-warning-background);
            border-radius: 8px;
            color: var(--color-warning);
        }
        .nav-tabs {
            display: flex;
            gap: 5px;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--tab-border-color);
            padding-bottom: 10px;
        }
        .nav-tabs .tab {
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            background: var(--table-background);
            border: none;
            color: var(--color-text);
        }
        .nav-tabs .tab:hover {
            background: var(--tab-hover-background);
        }
        .nav-tabs .tab.active {
            background: var(--tab-active-background);
            font-weight: bold;
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }
    </style>
{% endblock %}

{% block toolbar %}
    {% set icon %}
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline>
            <polyline points="7.5 19.79 7.5 14.6 3 12"></polyline>
            <polyline points="21 12 16.5 14.6 16.5 19.79"></polyline>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <span class="sf-toolbar-value">{{ collector.eventCount }}</span>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>DataMapper Events</b>
            <span class="sf-toolbar-status">{{ collector.eventCount }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>DataSource Calls</b>
            <span>{{ collector.dataSourceCallCount }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Hydrations</b>
            <span>{{ collector.hydrationCount }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Skipped</b>
            <span>{{ collector.skippedCount }}</span>
        </div>
        {% if collector.totalDuration > 0 %}
        <div class="sf-toolbar-info-piece">
            <b>Duration</b>
            <span>{{ '%.2f'|format(collector.totalDuration * 1000) }} ms</span>
        </div>
        {% endif %}
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, status: collector.eventCount > 0 ? '' : 'disabled' }) }}
{% endblock %}

{% block menu %}
    <span class="label{% if collector.eventCount == 0 %} disabled{% endif %}">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline>
                <polyline points="7.5 19.79 7.5 14.6 3 12"></polyline>
                <polyline points="21 12 16.5 14.6 16.5 19.79"></polyline>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
        </span>
        <strong>DataMapper</strong>
        <span class="count">
            <span>{{ collector.eventCount }}</span>
        </span>
    </span>
{% endblock %}

{% block panel %}
    <h2>DataMapper Data Lineage</h2>

    <div class="data-mapper-panel">
        {% if not collector.enabled %}
            <div class="data-mapper-disabled-notice">
                <p><strong>Data Lineage Collection is Disabled</strong></p>
                <p>Enable it in your configuration to see detailed data flow information:</p>
                <pre>
# config/packages/kassko_data_mapper.yaml
kassko_data_mapper:
    enable_lineage_collection: true
                </pre>
            </div>
        {% elseif collector.events|length == 0 %}
            <div class="data-mapper-no-events">
                <p>No DataMapper events were recorded during this request.</p>
                <p>This may happen if no data objects were hydrated.</p>
            </div>
        {% else %}
            <div class="data-mapper-summary">
                <div class="data-mapper-stat">
                    <div class="value">{{ collector.eventCount }}</div>
                    <div class="label">Total Events</div>
                </div>
                <div class="data-mapper-stat">
                    <div class="value">{{ collector.dataSourceCallCount }}</div>
                    <div class="label">DataSource Calls</div>
                </div>
                <div class="data-mapper-stat">
                    <div class="value">{{ collector.hydrationCount }}</div>
                    <div class="label">Hydrations</div>
                </div>
                <div class="data-mapper-stat">
                    <div class="value">{{ collector.skippedCount }}</div>
                    <div class="label">Skipped</div>
                </div>
                <div class="data-mapper-stat">
                    <div class="value">{{ collector.maxDepth }}</div>
                    <div class="label">Max Depth</div>
                </div>
                <div class="data-mapper-stat">
                    <div class="value">{{ '%.2f'|format(collector.totalDuration * 1000) }} ms</div>
                    <div class="label">Duration</div>
                </div>
            </div>

            <div class="nav-tabs" role="tablist">
                <button class="tab active" data-tab="timeline" role="tab">Timeline</button>
                <button class="tab" data-tab="by-class" role="tab">By Class</button>
                <button class="tab" data-tab="by-type" role="tab">By Type</button>
            </div>

            <div id="timeline" class="tab-content active">
                <h3>Event Timeline</h3>
                {% for event in collector.events %}
                    <div class="data-mapper-event {{ event.type }}" style="margin-left: {{ event.depth * 20 }}px;">
                        <div class="data-mapper-event-header">
                            <span class="data-mapper-event-type">{{ event.type|replace({'_': ' '}) }}</span>
                            <span class="data-mapper-event-timestamp">{{ '%.3f'|format(event.timestamp * 1000) }} ms</span>
                        </div>
                        <div class="data-mapper-event-details">
                            <code>{{ event.objectClass|split('\\')|last }}</code>
                            {% if event.propertyName %}
                                → <code>{{ event.propertyName }}</code>
                            {% endif %}
                            {% if event.source %}
                                via <code>{{ event.source }}</code>
                            {% endif %}
                            {% if event.reason %}
                                <br><small>Reason: {{ event.reason }}</small>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div id="by-class" class="tab-content">
                <h3>Events by Class</h3>
                {% for class, events in collector.eventsByClass %}
                    <div class="data-mapper-class-group">
                        <div class="data-mapper-class-header">
                            {{ class }}
                            <span class="badge">{{ events|length }} event(s)</span>
                        </div>
                        {% for event in events %}
                            <div class="data-mapper-event {{ event.type }}">
                                <div class="data-mapper-event-header">
                                    <span class="data-mapper-event-type">{{ event.type|replace({'_': ' '}) }}</span>
                                    <span class="data-mapper-event-timestamp">{{ '%.3f'|format(event.timestamp * 1000) }} ms</span>
                                </div>
                                <div class="data-mapper-event-details">
                                    {% if event.propertyName %}
                                        <code>{{ event.propertyName }}</code>
                                    {% endif %}
                                    {% if event.source %}
                                        via <code>{{ event.source }}</code>
                                    {% endif %}
                                    {% if event.reason %}
                                        <br><small>Reason: {{ event.reason }}</small>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>

            <div id="by-type" class="tab-content">
                <h3>Events by Type</h3>
                {% for type, events in collector.eventsByType %}
                    <div class="data-mapper-class-group">
                        <div class="data-mapper-class-header">
                            {{ type|replace({'_': ' '})|title }}
                            <span class="badge">{{ events|length }} event(s)</span>
                        </div>
                        {% for event in events %}
                            <div class="data-mapper-event {{ event.type }}">
                                <div class="data-mapper-event-header">
                                    <code>{{ event.objectClass|split('\\')|last }}</code>
                                    <span class="data-mapper-event-timestamp">{{ '%.3f'|format(event.timestamp * 1000) }} ms</span>
                                </div>
                                <div class="data-mapper-event-details">
                                    {% if event.propertyName %}
                                        <code>{{ event.propertyName }}</code>
                                    {% endif %}
                                    {% if event.source %}
                                        via <code>{{ event.source }}</code>
                                    {% endif %}
                                    {% if event.reason %}
                                        <br><small>Reason: {{ event.reason }}</small>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>

            <script>
                document.querySelectorAll('.nav-tabs .tab').forEach(function(tab) {
                    tab.addEventListener('click', function() {
                        // Remove active class from all tabs and contents
                        document.querySelectorAll('.nav-tabs .tab').forEach(function(t) {
                            t.classList.remove('active');
                        });
                        document.querySelectorAll('.tab-content').forEach(function(c) {
                            c.classList.remove('active');
                        });

                        // Add active class to clicked tab and corresponding content
                        tab.classList.add('active');
                        document.getElementById(tab.dataset.tab).classList.add('active');
                    });
                });
            </script>
        {% endif %}
    </div>
{% endblock %}
