{
    "name": "kassko/data-mapper-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle providing integration for DataMapper library.",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "kassko"
        }
    ],
    "keywords": [
        "symfony",
        "bundle",
        "symfony-bundle",
        "integration",
        "mapper",
        "data",
        "object",
        "lazy",
        "loading",
        "hydration",
        "source",
        "model",
        "lineage",
        "orm",
        "entity",
        "repository"
    ],
    "require": {
        "php": ">=8.1",
        "kassko/data-mapper": "^2.42",
        "symfony/framework-bundle": "^5.4|^6.0|^7.0",
        "symfony/dependency-injection": "^5.4|^6.0|^7.0",
        "symfony/config": "^5.4|^6.0|^7.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "psr/container": "^1.1|^2.0",
        "psr/simple-cache": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0",
        "symfony/console": "^5.4|^6.0|^7.0",
        "symfony/finder": "^5.4|^6.0|^7.0",
        "symfony/http-kernel": "^5.4|^6.0|^7.0",
        "symfony/twig-bundle": "^5.4|^6.0|^7.0",
        "symfony/web-profiler-bundle": "^5.4|^6.0|^7.0",
        "symfony/yaml": "^5.4|^6.0|^7.0"
    },
    "suggest": {
        "symfony/web-profiler-bundle": "Required for data lineage profiling in the debug toolbar",
        "symfony/twig-bundle": "Required for the data lineage profiler template"
    },
    "autoload": {
        "psr-4": {
            "Kassko\\Bundle\\DataMapperBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kassko\\Bundle\\DataMapperBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
